{
  "name": "maxim-apply-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/workspace.mjs setup",
    "workspace": "node scripts/workspace.mjs start",
    "stop": "node scripts/workspace.mjs stop",
    "backup": "node scripts/workspace.mjs backup",
    "restore": "node scripts/workspace.mjs restore",
    "key": "node scripts/workspace.mjs key",
    "test:integration": "node --test --test-concurrency=1 tests/integration/workspace.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run build && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@stylexjs/stylex": "0.19.2",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "node": "24.22.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
