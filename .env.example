# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Gemini Integration (Issue #344) ─────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
# Free API key: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens/day with gemini-2.5-flash (no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Override default Gemini model ───────────────────────────────────
# Default: gemini-2.5-flash (free-tier, fast)
# Alternatives: gemini-1.5-flash, gemini-1.5-pro, gemini-2.5-flash-thinking-exp
# GEMINI_MODEL=gemini-2.5-flash

# ── Other integrations (add your own below) ──────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here   # For Claude-based workflows
# OPENAI_API_KEY=your_openai_key_here          # Future OpenAI integration
# Maxim Apply local-only application answers.
# Keep real values in .env or ignored config/profile.yml; do not commit them.
MAXIM_CANDIDATE_EMAIL=
MAXIM_CANDIDATE_PHONE=
MAXIM_CANDIDATE_STREET_ADDRESS=
MAXIM_CANDIDATE_CITY=
MAXIM_CANDIDATE_STATE=
MAXIM_CANDIDATE_POSTAL_CODE=
MAXIM_CANDIDATE_COUNTRY=
MAXIM_CANDIDATE_LINKEDIN=
MAXIM_CANDIDATE_PORTFOLIO_URL=
MAXIM_CANDIDATE_GITHUB=
MAXIM_RELOCATION_OPEN=
MAXIM_SMS_CONSENT=

# Maxim Apply standardized ATS answers.
# Leave blank to force manual review instead of guessing.
#
# Common answer choices:
# - MAXIM_APPLICATION_SOURCE: "Company careers page", "LinkedIn", "Referral", "Recruiter", "Indeed", "Other"
# - MAXIM_PREVIOUS_EMPLOYER_RELATIONSHIP: "No" unless you have worked for that employer or an acquired company.
# - MAXIM_CONFLICT_OF_INTEREST: "No" unless a real conflict exists.
# - MAXIM_EXPORT_CONTROL_RESTRICTIONS: "No" unless you know you are restricted by export-control/sanctions rules.
# - MAXIM_US_PERSON: "Yes" if you are a U.S. citizen, U.S. national, lawful permanent resident, or otherwise qualify as a U.S. person for export-control purposes.
MAXIM_APPLICATION_SOURCE=
MAXIM_PREVIOUS_EMPLOYER_RELATIONSHIP=
MAXIM_CONFLICT_OF_INTEREST=
MAXIM_EXPORT_CONTROL_RESTRICTIONS=
MAXIM_US_PERSON=

# Maxim Apply voluntary self-identification answers.
# Leave blank to keep these fields in manual review.
# Common answer choices vary by ATS; the safest portable default is usually "Prefer not to answer".
# You can set MAXIM_SELF_ID_DEFAULT=Prefer not to answer, then override individual categories below.
# Examples: "Prefer not to answer", "I do not wish to answer", "Decline to self-identify", "No", "Yes".
MAXIM_SELF_ID_DEFAULT=
MAXIM_SELF_ID_GENDER=
MAXIM_SELF_ID_RACE_ETHNICITY=
MAXIM_SELF_ID_HISPANIC_LATINO=
MAXIM_SELF_ID_VETERAN_STATUS=
MAXIM_SELF_ID_DISABILITY_STATUS=
